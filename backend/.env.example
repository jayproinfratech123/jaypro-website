PORT=5000
# Allowed frontend origins, comma-separated; include preview domains if needed.
CLIENT_URL=http://localhost:5173
DB_HOST=YOUR_GODADDY_MYSQL_HOST
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=YOUR_MYSQL_DATABASE
DB_SSL=false
JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set temporarily for npm run admin:create; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
# Optional: existing payment functionality needs both keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
