PORT=3000
# Allowed frontend origins, comma-separated; include preview domains if needed.
CLIENT_URL=http://localhost:5173
JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set temporarily for npm run admin:create; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
# Optional: existing payment functionality needs both keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MongoDB: replace with your Atlas URI for hosted deployment.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=jayproinfratech
